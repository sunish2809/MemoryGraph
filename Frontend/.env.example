# The app calls a relative /api path by default, which the Vite dev server proxies to the backend.
# Override only if the backend is not on http://localhost:8080.
VITE_DEV_API_PROXY=http://localhost:8080

# Point the app at an absolute API URL instead of the relative default. Usually left unset.
# VITE_API_BASE_URL=http://localhost:8080/api/v1
