# Copy to .env and adjust. Never commit the real .env file.

# --- Database -----------------------------------------------------------------
POSTGRES_DB=memorygraph
POSTGRES_USER=memorygraph
POSTGRES_PASSWORD=change-me-locally
POSTGRES_PORT=5432
# Railway (private DNS, not used by local Compose):
# DATABASE_URL=jdbc:postgresql://postgres.railway.internal:5432/memorygraph

# --- Backend ------------------------------------------------------------------
BACKEND_PORT=8080

# HMAC-SHA256 signing key for access tokens. Must be at least 32 characters.
# Generate one with:  openssl rand -base64 48
JWT_SECRET=
JWT_ISSUER=memorygraph
# ISO-8601 duration. PT1H = one hour.
JWT_ACCESS_TOKEN_TTL=PT168H

# Closed beta: anyone with this string can create an account. Leave blank for open sign-up (local).
# Generate one with: openssl rand -base64 12
REGISTRATION_INVITE_CODE=

# Browser origins allowed to call the API directly. The Docker Compose setup proxies /api through
# the frontend, so this only matters when running the Vite dev server against a bare backend.
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

LOG_LEVEL_APP=INFO

# --- Media storage ------------------------------------------------------------
# Largest single file that may be uploaded (photos or WhatsApp / Takeout zips). Nginx must be ≥ this.
MAX_FILE_SIZE=1536MB
MAX_REQUEST_SIZE=1600MB

# --- Asynchronous processing --------------------------------------------------
# Threads available for enriching uploads (reading image dimensions today, models later). Bounded so a
# burst of uploads cannot starve the threads serving HTTP requests.
PROCESSING_WORKER_THREADS=4

# --- AI (Phase 4+) -------------------------------------------------------------
# Default: local hashing embeddings + retrieval-only Ask answers (no API key needed).
# To use OpenAI, set both providers to `openai` and supply OPENAI_API_KEY:
#   AI_CHAT_PROVIDER=openai
#   AI_EMBEDDING_PROVIDER=openai
#   OPENAI_API_KEY=sk-...
# Chat also enables photo captions during enrichment.
AI_CHAT_PROVIDER=none
AI_EMBEDDING_PROVIDER=none
OPENAI_API_KEY=
AI_EMBEDDING_MODEL=text-embedding-3-small
AI_CHAT_MODEL=gpt-4o-mini
AI_EMBEDDING_DIMENSIONS=1536
AI_ASK_TOP_K=8
AI_MAX_SEMANTIC_DISTANCE=0.45

# OCR (Phase 5): Tess4J calls the host Tesseract binary when present; otherwise the OCR job no-ops.
# Install separately if you want on-device text extraction from photos (e.g. brew install tesseract).

# --- Places (reverse geocode) -------------------------------------------------
# Nominatim (OpenStreetMap). Set GEOCODING_ENABLED=false to keep coordinate labels only.
GEOCODING_ENABLED=true
# GEOCODING_USER_AGENT=MemoryGraph/1.0 (your@email.example)

# --- Faces (Phase 10, free local InsightFace) ---------------------------------
# Detects faces via the Compose `faces` service (no cloud API key). First start downloads models
# into the face-models volume (~hundreds of MB) and needs ~2–4 GB RAM.
FACES_ENABLED=true
FACE_SERVICE_URL=http://faces:8090
FACE_MATCH_THRESHOLD=0.45
FACES_PORT=8090

# --- Google Photos Picker (optional live pick) --------------------------------
# Create an OAuth 2.0 Web client in Google Cloud, enable "Google Photos Picker API",
# and add authorized redirect URI: http://localhost:3000/import/google/callback
# (also http://localhost:5173/import/google/callback if using Vite).
# Scope used: photospicker.mediaitems.readonly — interactive pick only, not library sync.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:3000/import/google/callback

# --- Frontend -----------------------------------------------------------------
FRONTEND_PORT=3000
